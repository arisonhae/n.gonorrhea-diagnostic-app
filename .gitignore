# ============================================================
# 데이터
# ------------------------------------------------------------
# 원본 이미지는 용량이 커서 저장소에 포함하지 않는다.
# data/samples/ 안의 예시 이미지 몇 장만 예외로 커밋한다.
# 전체 데이터셋 위치는 data/README.md 참고.
# ============================================================
data/**
!data/README.md
!data/samples/
!data/samples/**

# 로컬 작업 폴더 (저장소 구조로 옮기기 전 원본)
dataset/
pilotimage_*/
sensitivityimage/
final_test/
image_onlyfortube_detection/
_yolo_check/
templates/

# ============================================================
# 분석 결과
# ------------------------------------------------------------
# 숫자 결과(csv, json)와 그림(png)은 남기고,
# 중간 산출 이미지(viz 오버레이 등)는 제외한다.
# ============================================================
analysis_output/
results/**/viz/
results/**/viz_conf/
results/**/previews/
results/**/*.jpg
results/**/*.jpeg

# ============================================================
# 모델
